# Copy this file to .env and fill in real values before your event.
# .env is already git-ignored so your admin password never gets committed.

# Password required to view the admin dashboard (teams, scores, visitor log).
# CHANGE THIS before your event.
ADMIN_PASSWORD=ASTRA-CMD-2026

# Random long string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on (Render/Railway set this automatically — leave blank there).
PORT=3000

# Set this to your public deployed URL (e.g. https://mission-astra.onrender.com)
# once you deploy, so the QR code always encodes the right link.
# Leave blank for local/LAN use — the server will detect it automatically.
PUBLIC_URL=

# Set to "1" only if you are deploying behind HTTPS (Render/Railway both are)
# and want the admin cookie to require HTTPS.
FORCE_HTTPS=1

# Optional: a Postgres connection string (e.g. from Render's free Postgres
# instance). If set, the app stores teams in Postgres instead of a local
# SQLite file — needed on Render's Free web service tier, since Free
# instances don't support persistent disks and would otherwise lose all
# data on every restart/redeploy. Leave blank for local development
# (SQLite is used automatically instead — zero setup required).
DATABASE_URL=
